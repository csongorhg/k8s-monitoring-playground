{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "alertmanager": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "storageClassName": {
          "type": "string",
          "minLength": 1
        },
        "pvcSize": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "image",
        "replicaCount",
        "storageClassName",
        "pvcSize",
        "resources"
      ]
    },
    "grafana": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "adminUser": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "image",
        "replicaCount",
        "adminUser",
        "resources"
      ]
    },
    "kubeStateMetrics": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "image",
        "replicaCount",
        "resources"
      ]
    },
    "nodeExporter": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "image",
        "resources"
      ]
    },
    "podinfo": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "image",
        "replicaCount",
        "resources"
      ]
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "tsdbRetention": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string",
          "minLength": 1
        },
        "pvcSize": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "image",
        "replicaCount",
        "tsdbRetention",
        "storageClassName",
        "pvcSize",
        "resources"
      ]
    }
  },
  "required": [
    "alertmanager",
    "grafana",
    "kubeStateMetrics",
    "nodeExporter",
    "podinfo",
    "prometheus"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "tag"
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceValues"
        },
        "limits": {
          "$ref": "#/definitions/resourceValues"
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "resourceValues": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cpu",
        "memory"
      ]
    }
  }
}
